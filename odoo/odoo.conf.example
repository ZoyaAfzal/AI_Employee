[options]
; Odoo 17 Community — Gold Tier AI Employee
; Copy this file to odoo.conf and fill in your values. NEVER commit odoo.conf.
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; Database — must match POSTGRES_USER/PASSWORD in .env
db_host = db
db_port = 5432
db_name = odoo
db_user = odoo
db_password = CHANGE_ME_DB_PASSWORD

; Security — set a strong master password before first use
admin_passwd = CHANGE_ME_MASTER_PASSWORD

; JSON-RPC access (for MCP server)
xmlrpc = True
xmlrpc_port = 8069

; Longpolling
longpolling_port = 8072

; Performance
workers = 2
max_cron_threads = 1
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_request = 8192
limit_time_cpu = 120
limit_time_real = 240

; Logging
log_level = warn
log_handler = :WARNING

; Demo data — set to False for production
without_demo = False
