# Odoo Docker Compose Environment — copy to .env and fill in values
# NEVER commit .env to git

POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_pass_change_me

# Odoo JSON-RPC connection (used by odoo_mcp/server.py)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
