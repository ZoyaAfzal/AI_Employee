# ═══════════════════════════════════════════════════════════
# AI Employee — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════

# ── Vault ──────────────────────────────────────────────────
# Absolute path to the Obsidian vault folder
VAULT_PATH=/mnt/c/Users/Admin/OneDrive/Desktop/AI_Employee/AI_Employee_Vault

# ── Claude Code ────────────────────────────────────────────
# Path to the claude binary (leave as-is if claude is on PATH)
CLAUDE_PATH=claude

# ── Gmail ──────────────────────────────────────────────────
# Used by gmail_auth.py to identify which account to connect.
# The actual OAuth token is stored in watchers/credentials/token.json
# after running: python watchers/gmail_auth.py
GMAIL_SENDER_ADDRESS=you@gmail.com

# Gmail query for the watcher — change to taste
# Default watches unread+important; use "is:unread" for all unread
GMAIL_QUERY=is:unread is:important

# How often to poll Gmail (seconds). Default 120 (2 min).
GMAIL_CHECK_INTERVAL=120

# ── LinkedIn ───────────────────────────────────────────────
# Used for automated login (optional — you can also log in manually
# on first run with LINKEDIN_FIRST_LOGIN=true)
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# How often to poll LinkedIn (seconds). Default 300 (5 min).
LINKEDIN_CHECK_INTERVAL=300

# ── Watchers Toggle ────────────────────────────────────────
ENABLE_GMAIL=true
ENABLE_LINKEDIN=true
ENABLE_FILESYSTEM=true

# ── Safety ─────────────────────────────────────────────────
# Set to true to run in dry-run mode — watchers detect events
# but no files are written to the vault and no emails/posts sent.
LOG_ONLY=false

# ── Rate Limits (per Company Handbook) ────────────────────
MAX_EMAILS_PER_HOUR=10
MAX_LINKEDIN_POSTS_PER_DAY=2
